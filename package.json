{
  "name": "@cognitive-fab/polyx-lens",
  "version": "0.1.0",
  "description": "Read an agent's own logs and report which of the rules it was given it actually kept. No mining, no model call, nothing leaves the machine.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognitive-fab/polyx-lens.git"
  },
  "homepage": "https://github.com/cognitive-fab/polyx-lens#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "polyx-lens": "bin/polyx-lens.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "imports": {
    "#polyness/*": "./vendor/polyness/src/*"
  },
  "files": [
    "dist",
    "src",
    "alphabets",
    "contracts",
    "fixtures",
    "vendor",
    "bin",
    "polyx.config.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --no-warnings --test \"test/**/*.test.ts\"",
    "ci": "npm run typecheck && npm run check:offline && npm run build && npm test",
    "prepare": "npm run build",
    "check:offline": "node --no-warnings scripts/check-offline.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
